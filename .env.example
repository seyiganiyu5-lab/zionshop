# Postgres connection strings. On Vercel these are filled in automatically
# when you connect a Neon database (Storage tab). Locally both can be the same.
DATABASE_URL="postgresql://postgres@localhost:5432/zionshop"
DATABASE_URL_UNPOOLED="postgresql://postgres@localhost:5432/zionshop"

# The password you type on the login page.
ADMIN_PASSWORD="change-me"

# Random string used to sign the login cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Shown on receipts and money amounts.
NEXT_PUBLIC_SHOP_NAME="Zionshop"
NEXT_PUBLIC_CURRENCY="NGN"

# Decides when "today" starts on the dashboard.
SHOP_TIMEZONE="Africa/Lagos"
