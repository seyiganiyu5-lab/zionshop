# Postgres connection strings. On Vercel these are filled in automatically
# when you connect a Neon database (Storage tab). Locally both can be the same.
DATABASE_URL="postgresql://postgres@localhost:5432/zionshop"
DATABASE_URL_UNPOOLED="postgresql://postgres@localhost:5432/zionshop"

# Used once: the first sign-in with these creates the owner account.
# After that they're ignored. Change your password in Settings after signing in.
ADMIN_USERNAME="owner"
ADMIN_PASSWORD="choose-a-long-password"

# Random secret (at least 32 characters) used to encrypt the two-step
# verification key. Generate one with:  openssl rand -base64 32
# Don't change it once two-step verification is on, or you'll need scripts/reset-owner.mjs.
AUTH_SECRET="replace-with-a-long-random-string"

# Shown on receipts and money amounts.
NEXT_PUBLIC_SHOP_NAME="Zionshop"
NEXT_PUBLIC_CURRENCY="NGN"

# Decides when "today" starts on the dashboard.
SHOP_TIMEZONE="Africa/Lagos"
